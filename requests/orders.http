### Orders lifecycle
#
# Before running: paste an admin access token into @accessToken below
# (run the Login request in auth.http first).
#
# The seed creates 2 locations with fixed UUIDs:
#   Location A → 11111111-1111-1111-1111-111111111111
#   Location B → 22222222-2222-2222-2222-222222222222

@base = http://localhost:3000
@accessToken = PASTE_FROM_auth.http
@locationA = 11111111-1111-1111-1111-111111111111
@locationB = 22222222-2222-2222-2222-222222222222

### Create an order with pickup fulfillment
# @name createPickup
POST {{base}}/api/orders
content-type: application/json

{
  "customerName": "Jane Doe",
  "customerPhone": "+30 6900 000 000",
  "customerEmail": "jane@example.com",
  "cleaningType": "wash_fold",
  "processingSpeed": "standard",
  "fulfillment": "pickup",
  "pickupLocationId": "{{locationA}}",
  "locationId": "{{locationA}}",
  "notes": "Leave at the front desk"
}

### Capture the order id from the response above
@orderId = {{createPickup.response.body.id}}
@trackingCode = {{createPickup.response.body.trackingCode}}

### Create an order with express + delivery
POST {{base}}/api/orders
content-type: application/json

{
  "customerName": "Bob Smith",
  "customerPhone": "+30 6900 111 111",
  "cleaningType": "dry_cleaning",
  "processingSpeed": "express",
  "fulfillment": "delivery",
  "deliveryAddress": "Kifisias 15, Athens 115 26",
  "deliveryLat": 37.9838,
  "deliveryLng": 23.7275,
  "locationId": "{{locationB}}"
}

### Public: customer tracking page data (no auth required)
GET {{base}}/api/track/{{trackingCode}}

### List orders (default: newest first, limit 50)
GET {{base}}/api/orders
authorization: Bearer {{accessToken}}

### List orders filtered by status
GET {{base}}/api/orders?status=received
authorization: Bearer {{accessToken}}

### List orders filtered by location + fulfillment
GET {{base}}/api/orders?locationId={{locationA}}&fulfillment=pickup
authorization: Bearer {{accessToken}}

### Search orders (name, phone, or tracking code)
GET {{base}}/api/orders?search=Jane
authorization: Bearer {{accessToken}}

### Order detail with events timeline
GET {{base}}/api/orders/{{orderId}}
authorization: Bearer {{accessToken}}

### ─────────────────────────────────────────────────────────────────────
### State machine transitions (run in order)
### ─────────────────────────────────────────────────────────────────────

### Step 1: received → not_started  (staff / admin)
PATCH {{base}}/api/orders/{{orderId}}/status
authorization: Bearer {{accessToken}}
content-type: application/json

{
  "toStatus": "not_started"
}

### Step 2: not_started → working  (staff / admin; machineId required)
# Find a machine id in Prisma Studio → machines table.
# Or query GET /api/machines once phase 6 lands.
PATCH {{base}}/api/orders/{{orderId}}/status
authorization: Bearer {{accessToken}}
content-type: application/json

{
  "toStatus": "working",
  "machineId": "PASTE_A_MACHINE_UUID"
}

### Step 3: working → finished  (staff / admin)
PATCH {{base}}/api/orders/{{orderId}}/status
authorization: Bearer {{accessToken}}
content-type: application/json

{
  "toStatus": "finished"
}

### Step 4: finished → out_for_delivery  (staff / admin; driverId required)
# First create a delivery user in admin.http, grab its id.
PATCH {{base}}/api/orders/{{orderId}}/status
authorization: Bearer {{accessToken}}
content-type: application/json

{
  "toStatus": "out_for_delivery",
  "driverId": "PASTE_A_DELIVERY_USER_UUID"
}

### Step 5: out_for_delivery → delivered  (delivery / admin)
# This one must be run with the delivery user's token, not admin's —
# unless you're using the admin token (admin bypasses role checks).
PATCH {{base}}/api/orders/{{orderId}}/status
authorization: Bearer {{accessToken}}
content-type: application/json

{
  "toStatus": "delivered"
}

### Tracking page now shows full history
GET {{base}}/api/track/{{trackingCode}}
