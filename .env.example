# ============================================================================
# Laundry App — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit a real .env to source control.

# --- Core ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
WIDGET_PORT=5174

# Public URL the app is served from (used in tracking links sent to customers)
PUBLIC_APP_URL=http://localhost:5173

# --- Database (Postgres) ---
# When running via docker-compose, POSTGRES_HOST should be "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=laundry
POSTGRES_PASSWORD=laundry
POSTGRES_DB=laundry
DATABASE_URL=postgresql://laundry:laundry@localhost:5432/laundry?schema=public

# --- Redis ---
# When running via docker-compose, REDIS_HOST should be "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Miele 3rd Party API ---
# Obtain these from the Miele Developer Portal
MIELE_CLIENT_ID=
MIELE_CLIENT_SECRET=
MIELE_REDIRECT_URI=http://localhost:3000/api/miele/oauth/callback
MIELE_AUTH_URL=https://api.mcs3.miele.com/thirdparty/login
MIELE_TOKEN_URL=https://api.mcs3.miele.com/thirdparty/token
MIELE_API_BASE=https://api.mcs3.miele.com/v1

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Laundry Store <noreply@example.com>"

# --- Google Maps ---
# Used by the customer widget for delivery address picking
# Browser-exposed: restrict by HTTP referrer in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to POST to /api/orders
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
